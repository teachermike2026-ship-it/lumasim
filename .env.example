# ---------------------------------------------------------------------------
# LumaSIM environment template
#
# Copy to `.env` for local development:  copy .env.example .env
# Never commit real secrets. Every value below is required unless the comment
# says "optional". See docs/ARCHITECTURE.md for the full variable reference and
# docs/OWNER-INPUTS.md for the values only a business owner can supply.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Local demo database (SQLite). For production use a managed PostgreSQL
# database and switch the datasource provider in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# --- Site -------------------------------------------------------------------
# Public site origin, no trailing slash. Used for canonical URLs, sitemap,
# robots, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Shows the sample-data banner and "demo data" labels throughout the storefront.
# Keep "true" until a real supplier catalog is connected.
NEXT_PUBLIC_DEMO_MODE="true"

# Public support address shown in the footer, contact pages and policies.
NEXT_PUBLIC_SUPPORT_EMAIL="support@lumasim.example"

# --- Payments ---------------------------------------------------------------
# PAYMENTS_PROVIDER: "mock" or "stripe".
# The mock provider is a local demo checkout. It must never be enabled on a
# deployment that accepts real orders, and it cannot be reached over the
# internet by accident: it needs both flags below to stay switched on.
PAYMENTS_PROVIDER="mock"
ALLOW_MOCK_PAYMENTS="true"

# Stripe test-mode credentials (required when PAYMENTS_PROVIDER="stripe").
# STRIPE_WEBHOOK_SECRET comes from the endpoint at /api/webhooks/stripe.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- eSIM supplier ----------------------------------------------------------
# SUPPLIER_ADAPTER: "mock" is the only adapter shipped in this build.
# Any other value throws at startup on purpose, so the storefront can never
# pretend to deliver a product it cannot actually deliver.
SUPPLIER_ADAPTER="mock"
SUPPLIER_API_BASE_URL=""
SUPPLIER_API_KEY=""
SUPPLIER_TIMEOUT_MS="8000"

# Fulfilment attempts and retry backoff (400 ms, 1200 ms) are code constants in
# src/lib/supplier.ts (SUPPLIER_MAX_ATTEMPTS / SUPPLIER_RETRY_BACKOFF_MS), not
# environment variables, so they stay identical across environments.

# Development and load-testing helper: a 0-1 chance that the mock supplier
# fails after payment, so the retry and refund paths can be exercised.
# Leave at "0" everywhere except a test environment.
MOCK_SUPPLIER_FAILURE_RATE="0"

# --- Transactional email ----------------------------------------------------
# Without a Resend key, messages are recorded with status SIMULATED in the
# EmailLog table and password reset links are written to the server console.
RESEND_API_KEY=""
EMAIL_FROM="LumaSIM <no-reply@example.com>"
# Internal destination for contact-form submissions.
CONTACT_TO_EMAIL="support@lumasim.example"
# Server-side default for transactional replies and the fallback destination
# for contact-form submissions when CONTACT_TO_EMAIL is empty.
SUPPORT_EMAIL="support@lumasim.example"

# --- Security ---------------------------------------------------------------
# Pepper for hashing IP addresses used only for abuse prevention and rate
# limiting. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET="replace-with-a-long-random-string"

# --- Demo data --------------------------------------------------------------
# Credentials for the local seed only. Rotate before production and never
# reuse them on a live deployment.
SEED_ADMIN_EMAIL="admin@lumasim.example"
SEED_ADMIN_PASSWORD="LocalOnly-ChangeMe-2026!"

# The demo seed refuses to run against NODE_ENV=production unless this is
# explicitly "true". Set it only for an intentional preview environment.
ALLOW_DEMO_SEED="false"

# --- Optional integrations --------------------------------------------------
# Google Search Console verification token.
GOOGLE_SITE_VERIFICATION=""

# Sentry-compatible DSN. Not wired in this build; reserved so error monitoring
# can be added without a schema change.
ERROR_MONITORING_DSN=""

# Retention window, in days, for first-party consent-gated analytics events.
# Must match the figure quoted in the Privacy and Cookie policies.
ANALYTICS_RETENTION_DAYS="180"
